  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:sheets": "node --conditions=react-server --import tsx scripts/test-sheets.ts",
    "typecheck": "tsc --noEmit",
    "test:inventory": "node --conditions=react-server --import tsx scripts/test-inventory.ts",
    "test:all": "npm test && npm run test:sheets && npm run test:inventory && npm run test:telegram",
    "test:telegram": "node --conditions=react-server --import tsx scripts/test-telegram-local.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup:transactions": "node --conditions=react-server --import tsx scripts/setup-transaction-sheet.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.6",
    "googleapis": "^182.0.0",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
