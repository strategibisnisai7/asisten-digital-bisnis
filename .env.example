# Server-side only. Do not use NEXT_PUBLIC_ for these variables.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste private_key from the service account JSON inside double quotes.
# Escaped newlines (\n) and real multiline PEM keys are both supported.
GOOGLE_SHEETS_PRIVATE_KEY=

# Telegram server-side credentials. Never commit the filled .env file.
TELEGRAM_BOT_TOKEN=
# Independent random secret, 32-256 URL-safe characters; used by setWebhook later.
TELEGRAM_WEBHOOK_SECRET=
